# The default server profile for scripts/deploy.sh.
# The deployment helper creates deploy/.env.development from this template.
# Never commit the generated file: it contains API and encryption keys.

WEB_PORT=3003
API_PORT=8001
CORS_ORIGINS=http://localhost:3003
APP_ENVIRONMENT=development
AUTH_ENABLED=false
DEPLOYMENT_MODE=single_user

# Required by the deployment Compose file and generated by deploy.sh.
# Development mode does not mount the CSRF middleware.
CSRF_SECRET_KEY=replace-with-a-random-string-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-fernet-key

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
LLM_REQUIRED=true
LLM_TRUST_ENV=false

APP_AUTO_CREATE_TABLES=true
APP_AUTO_SEED_SYSTEM=true
APP_RUN_SCHEDULER=true
APP_RUN_ACTIVITY_ENGINE=true
AMBIENT_MONITOR_ENABLED=true
MAX_UPLOAD_SIZE_MB=500
EMBEDDING_MODE=auto

CODE_SANDBOX_BACKEND=container
CODE_SANDBOX_RUNTIME=docker
CODE_SANDBOX_IMAGE=python:3.11-alpine
ALLOW_INSECURE_PROCESS_SANDBOX=false
DOCKER_SOCK=/var/run/docker.sock

API_PYTHON_REQUIREMENTS=requirements-core.txt
