# Copy to deploy/.env.production and fill every REQUIRED value before starting.
# Never commit deploy/.env.production or paste API keys into the frontend.

WEB_PORT=3003
API_PORT=8001
CORS_ORIGINS=http://localhost:3003

# Generate these values using the commands in DEPLOYMENT.md.
JWT_SECRET_KEY=replace-with-a-random-string-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-fernet-key

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
LLM_REQUIRED=true

# Optional provider keys (leave blank when unused).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

APP_AUTO_CREATE_TABLES=true
APP_AUTO_SEED_SYSTEM=true
APP_RUN_SCHEDULER=true
APP_RUN_ACTIVITY_ENGINE=true
AMBIENT_MONITOR_ENABLED=true
MAX_UPLOAD_SIZE_MB=500
EMBEDDING_MODE=auto

# The secure container backend needs Docker socket access.
CODE_SANDBOX_BACKEND=container
CODE_SANDBOX_RUNTIME=docker
CODE_SANDBOX_IMAGE=python:3.11-alpine
ALLOW_INSECURE_PROCESS_SANDBOX=false
DOCKER_SOCK=/var/run/docker.sock

API_PYTHON_REQUIREMENTS=requirements-core.txt
